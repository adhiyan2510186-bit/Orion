# Copy to backend/.env and edit. backend/.env is gitignored and must never be committed.

# --- Pluggable implementations, resolved from the registries at startup ---
# parquet = pre-normalised committed fixture (fast, the demo path)
# netcdf  = parses raw GDAC .nc files directly (proves real telemetry ingestion)
DATA_PROVIDER=parquet

# rule = deterministic, no network, no cost, cannot fail during a demo
NLP_PARSER=rule

# Comma-separated. Registered: surface_heatwave, salinity_outlier, cold_anomaly
ANOMALY_DETECTORS=surface_heatwave,salinity_outlier

# --- Optional ---
# Override the data source path. Defaults per provider.
# FIXTURE_PATH=

# CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Result-size guards.
DEFAULT_LIMIT=50000
MAX_LIMIT=500000

# --- Frontend (set in the shell or frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE=http://localhost:8000
